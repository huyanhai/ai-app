generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model ModelConfig {
  id          String   @id
  category    String
  name        String
  provider    String
  modelId     String
  baseURL     String
  apiKey      String
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  description String?
  params      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, enabled])
}
