generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model ModelConfig {
  id          String   @id
  category    String
  name        String
  provider    String
  modelId     String
  baseURL     String
  apiKey      String
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  description String?
  params      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, enabled])
}

model AgentSession {
  id        String         @id
  title     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  AgentMessage[]
}

model AgentMessage {
  id        Int          @id @default(autoincrement())
  sessionId String
  role      String
  content   String
  attachments String?
  subjects  String?
  mode      String       @default("agent")
  createdAt DateTime     @default(now())
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt, id])
}

model CanvasState {
  id        String   @id @default(cuid())
  title     String   @default("未命名画布")
  nodes     String
  edges     String
  past      String   @default("[]")
  future    String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GenerationRecord {
  id        String   @id @default(cuid())
  nodeId    String
  nodeType  String
  title     String
  model     String?
  url       String
  canvasId  String   @default("default")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([canvasId, createdAt])
}

model ProductionProject {
  id        String   @id
  idea      String
  modelId   String?
  status    String   @default("draft")
  plan      String
  requirements String?
  nodes     String
  edges     String
  error     String?
  mediaMode String?
  events    String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
